# Dosya yok sayma hakkında: https://help.github.com/articles/ignoring-files/

# bağımlılıklar
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# test çıktıları
/coverage

# Next.js çıktıları
/.next/
/.vinext/
/out/

# diğer dosyalar
.DS_Store
*.pem

# hata ayıklama günlükleri
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ortam dosyaları (gerektiğinde açıkça dahil edilebilir)
.env*

# Vercel
.vercel

# TypeScript
next-env.d.ts
/dist/
/.wrangler/
# Yalnızca bu çalışma kopyasına ait araç durumu; yayımlanmaz.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

*.tsbuildinfo
